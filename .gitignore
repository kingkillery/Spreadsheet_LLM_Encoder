# Python bytecode
__pycache__/
*.py[cod]
*.pyc

# Virtual environments
env/
venv/
.venv/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Test and coverage outputs
.pytest_cache/
*.cover
coverage.xml

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# OS metadata
.DS_Store

